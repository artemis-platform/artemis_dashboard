<Layouts.page_header title={Gettext.gettext(ArtemisWeb.Gettext, @page_title)}>
  <:actions>
    <.button variant="primary" navigate={~p"/customers/new"}>
      <.icon name="hero-plus" /> New
    </.button>
  </:actions>
  <:tabs>
    <Layouts.header_tab href={~p"/customers"} label="Overview" active />
    <Layouts.header_tab href="#" label="Event Logs" />
  </:tabs>
</Layouts.page_header>

<Layouts.page_content>
  <ArtemisWeb.Breadcrumbs.breadcrumbs uri={@uri} />

  <.header>
    {gettext("Customers")}
  </.header>

  <Slab.table id="customers" schema={Artemis.Customer} uri={@uri} params={@params}>
    <:tab name="filters" />
    <:tab name="columns" />
    <:tab name="export" />
    <:tab name="share" />

    <:filter field={:name} />

    <:column_checkbox />
    <:column field={:name} sortable />
    <:column :let={resource} label="Actions">
      <.link navigate={~p"/customers/#{resource}"}>{gettext("View")}</.link>
      <.link navigate={~p"/customers/#{resource}/edit"}>{gettext("Edit")}</.link>
    </:column>

    <:pagination mode={:page} />
  </Slab.table>
</Layouts.page_content>

<.table
  id="customers"
  rows={@streams.resources}
  row_click={fn {_id, resource} -> JS.navigate(~p"/customers/#{resource}") end}
>
  <:col :let={{_id, resource}} label="Name">{resource.name}</:col>
  <:action :let={{_id, resource}}>
    <div class="sr-only">
      <.link navigate={~p"/customers/#{resource}"}>Show</.link>
    </div>
    <.link navigate={~p"/customers/#{resource}/edit"}>Edit</.link>
  </:action>
  <:action :let={{id, resource}}>
    <.link
      phx-click={JS.push("delete", value: %{id: resource.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>
